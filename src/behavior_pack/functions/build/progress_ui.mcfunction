# actionbar progress every 10 ticks (no chat spam)
scoreboard players operation #bpctb bce_sys = #bstep bce_sys
scoreboard players operation #bpctb bce_sys -= #bstart bce_sys
scoreboard players operation #bpctb bce_sys *= #c100 bce_sys
scoreboard players operation #bden bce_sys = #bstop bce_sys
scoreboard players operation #bden bce_sys -= #bstart bce_sys
execute if score #bden bce_sys matches 1.. run scoreboard players operation #bpctb bce_sys /= #bden bce_sys
execute unless score #bsm bce_sys matches 2 unless score #bsm bce_sys matches 5..7 if score #bzone bce_sys matches 0 if score #bstage bce_sys matches 0 run titleraw @a actionbar {"rawtext":[{"text":"§e검은별의 성채 건축 중… §f"},{"score":{"name":"#bpctb","objective":"bce_sys"}},{"text":"% §7| 깨어남의 신전 · 지형·기초"}]}
