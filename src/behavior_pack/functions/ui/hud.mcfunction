# actionbar HUD every 5 ticks. 2s mission page / 2s skill-cooldown page. HP = vanilla hearts (commands cannot read health)
scoreboard players operation #hp bce_sys = #tick bce_sys
scoreboard players operation #hp bce_sys /= #c20 bce_sys
scoreboard players operation #hp bce_sys %= #c4 bce_sys
execute if score #hp bce_sys matches 0..1 as @a[tag=bce_ctl,tag=!bce_cs,scores={bce_ps=2..6,bce_q=1}] run titleraw @s actionbar {"rawtext":[{"text":"§aST§f "},{"score":{"name":"@s","objective":"bce_stam"}},{"text":" §e회피§f "},{"score":{"name":"@s","objective":"bce_cddodge"}},{"text":" §b신전 중앙으로"}]}
